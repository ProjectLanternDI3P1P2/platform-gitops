{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "keycloak",
    "namespace": "keycloak"
  },
  "spec": {
    "ingressClassName": "traefik",
    "rules": [
      {
        "host": "auth.lantern.diiage",
        "http": {
          "paths": [
            {
              "backend": {
                "service": {
                  "name": "keycloak",
                  "port": {
                    "number": 8080
                  }
                }
              },
              "path": "/",
              "pathType": "Prefix"
            }
          ]
        }
      }
    ]
  }
}