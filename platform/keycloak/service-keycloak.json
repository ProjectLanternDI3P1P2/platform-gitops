{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "keycloak",
    "namespace": "keycloak"
  },
  "spec": {
    "internalTrafficPolicy": "Cluster",
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "protocol": "TCP",
        "targetPort": 8080
      }
    ],
    "selector": {
      "app": "keycloak"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}