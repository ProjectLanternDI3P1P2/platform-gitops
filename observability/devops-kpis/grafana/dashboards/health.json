{
  "uid": "lantern-devops-health",
  "title": "Lantern · Kubernetes & Microservices Health",
  "tags": [
    "Lantern",
    "DevOps"
  ],
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Lantern DevOps",
      "tags": [
        "Lantern"
      ],
      "keepTime": true,
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Kubernetes Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "combat,dungeon,frontend-game,frontend-public,leaderboard,player,rewards",
        "multi": true,
        "includeAll": true,
        "allValue": "combat|dungeon|frontend-game|frontend-public|leaderboard|player|rewards",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "combat",
            "value": "combat",
            "selected": false
          },
          {
            "text": "dungeon",
            "value": "dungeon",
            "selected": false
          },
          {
            "text": "frontend-game",
            "value": "frontend-game",
            "selected": false
          },
          {
            "text": "frontend-public",
            "value": "frontend-public",
            "selected": false
          },
          {
            "text": "leaderboard",
            "value": "leaderboard",
            "selected": false
          },
          {
            "text": "player",
            "value": "player",
            "selected": false
          },
          {
            "text": "rewards",
            "value": "rewards",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "title": "Workload rollout status",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open service detail",
                    "url": "/d/lantern-devops-service/lantern-service-detail?var-service=${__data.fields.service_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "(last_over_time({job=\"kubernetes-pods\",namespace=\"monitoring\",container=\"lantern-kpi-collector\"} |= \"LANTERN_KPI \" | regexp `LANTERN_KPI (?P<payload>\\{.*\\})$` | line_format \"{{.payload}}\" | json kpi_kind=\"kind\", kpi_value=\"value\", service_id, repository, squad, snapshot, status | kpi_kind=\"workload_rollout_info\" | service_id=~\"${service:regex}\" | unwrap kpi_value | __error__=\"\" [15m]) by (service_id, snapshot, status)) and on (service_id, snapshot) topk by (service_id) (1, max_over_time({job=\"kubernetes-pods\",namespace=\"monitoring\",container=\"lantern-kpi-collector\"} |= \"LANTERN_KPI \" | regexp `LANTERN_KPI (?P<payload>\\{.*\\})$` | line_format \"{{.payload}}\" | json kpi_kind=\"kind\", kpi_value=\"value\", service_id, repository, squad, snapshot | kpi_kind=\"collector_snapshot\" | service_id=~\"${service:regex}\" | unwrap kpi_value | __error__=\"\" [15m]) by (service_id, snapshot))",
          "legendFormat": "",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "snapshot": true,
              "Value": true
            },
            "indexByName": {
              "service_id": 0,
              "status": 1
            }
          }
        }
      ],
      "id": 1
    },
    {
      "title": "Argo CD application status",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(last_over_time({job=\"kubernetes-pods\",namespace=\"monitoring\",container=\"lantern-kpi-collector\"} |= \"LANTERN_KPI \" | regexp `LANTERN_KPI (?P<payload>\\{.*\\})$` | line_format \"{{.payload}}\" | json kpi_kind=\"kind\", kpi_value=\"value\", service_id, repository, squad, snapshot, health, sync, gitops_revision | kpi_kind=\"argo_application_info\" | service_id=~\"${service:regex}\" | unwrap kpi_value | __error__=\"\" [15m]) by (service_id, snapshot, health, sync, gitops_revision)) and on (service_id, snapshot) topk by (service_id) (1, max_over_time({job=\"kubernetes-pods\",namespace=\"monitoring\",container=\"lantern-kpi-collector\"} |= \"LANTERN_KPI \" | regexp `LANTERN_KPI (?P<payload>\\{.*\\})$` | line_format \"{{.payload}}\" | json kpi_kind=\"kind\", kpi_value=\"value\", service_id, repository, squad, snapshot | kpi_kind=\"collector_snapshot\" | service_id=~\"${service:regex}\" | unwrap kpi_value | __error__=\"\" [15m]) by (service_id, snapshot))",
          "legendFormat": "",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "snapshot": true,
              "Value": true
            },
            "indexByName": {
              "service_id": 0,
              "health": 1,
              "sync": 2,
              "gitops_revision": 3
            }
          }
        }
      ],
      "id": 2
    },
    {
      "title": "Desired and available replicas",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time({job=\"kubernetes-pods\",namespace=\"monitoring\",container=\"lantern-kpi-collector\"} |= \"LANTERN_KPI \" | regexp `LANTERN_KPI (?P<payload>\\{.*\\})$` | line_format \"{{.payload}}\" | json kpi_kind=\"kind\", kpi_value=\"value\", service_id, repository, squad, measure | kpi_kind=\"workload_measure\" | service_id=~\"${service:regex}\" | measure=~\"desired|available\" | unwrap kpi_value | __error__=\"\" [10m]) by (service_id, measure)",
          "legendFormat": "{{service_id}} · {{measure}}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 3
    },
