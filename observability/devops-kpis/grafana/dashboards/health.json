          "expr": "last_over_time({job=\"kubernetes-pods\",namespace=\"monitoring\",container=\"lantern-kpi-collector\"} |= \"LANTERN_KPI \" | regexp `LANTERN_KPI (?P<payload>\\{.*\\})$` | line_format \"{{.payload}}\" | json kpi_kind=\"kind\", kpi_value=\"value\", service_id, repository, squad, measure | kpi_kind=\"workload_measure\" | service_id=~\"${service:regex}\" | measure=~\"crashloop_containers\" | unwrap kpi_value | __error__=\"\" [10m]) by (service_id, measure)",
