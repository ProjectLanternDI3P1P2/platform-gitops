    {
      "title": "Application error and warning log lines",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 32
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (namespace) (count_over_time({job=\"kubernetes-pods\",namespace=~\"${service:regex}\",container=~\"api|player-api|frontend-game|frontend-public\"} |~ \"(?i)(^|[[:space:]\\\"\\\\[])(error|err|fail|fatal|critical)([[:space:]\\\"\\\\]:,]|$)\" [$__interval]))",
          "legendFormat": "{{namespace}} errors",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace) (count_over_time({job=\"kubernetes-pods\",namespace=~\"${service:regex}\",container=~\"api|player-api|frontend-game|frontend-public\"} |~ \"(?i)(^|[[:space:]\\\"\\\\[])(warn|warning)([[:space:]\\\"\\\\]:,]|$)\" [$__interval]))",
          "legendFormat": "{{namespace}} warnings",
          "queryType": "range",
          "datasource": {
