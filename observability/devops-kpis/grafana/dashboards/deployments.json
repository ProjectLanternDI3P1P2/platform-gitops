{
  "uid": "lantern-devops-deployments",
  "title": "Lantern · Deployments & Container Security",
  "tags": [
    "Lantern",
    "DevOps"
  ],
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Lantern DevOps",
      "tags": [
        "Lantern"
      ],
      "keepTime": true,
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lantern-devops-prometheus"
        },
        "definition": "label_values(lantern_service_info, service)",
        "query": {
          "query": "label_values(lantern_service_info, service)",
          "refId": "var-service"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "combat|dungeon|frontend-game|frontend-public|leaderboard|player|rewards",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "",
      "type": "text",
      "datasource": null,
      "description": "",
      "gridPos": {
        "w": 24,
        "h": 3,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Confirmed means the latest observed validated release matches GitOps and every running replica, the rollout is complete, and Argo CD reports Synced and Healthy. Missing evidence is shown as insufficient."
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "targets": [],
      "id": 1
    },
    {
      "title": "Release delivery assessment",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "lantern-devops-prometheus"
      },
