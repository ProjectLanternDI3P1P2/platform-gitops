    {
      "title": "Last CI execution",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "lantern-devops-prometheus"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 11
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open GitHub Actions run",
                    "url": "https://github.com/ProjectLanternDI3P1P2/${__data.fields.repository}/actions/runs/${__data.fields.run_id}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "1000 * (lantern_ci_last_run_timestamp_seconds{service=~\"${service:regex}\",repository=~\"${repository:regex}\",squad=~\"${squad:regex}\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lantern-devops-prometheus"
          },
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "container": true,
              "deployment": true,
              "squad": true
            },
            "indexByName": {
              "service": 0,
              "repository": 1,
              "status": 2,
              "sha": 3,
              "run_id": 4,
              "Value": 5
            }
          }
        }
      ],
      "id": 6
    },
