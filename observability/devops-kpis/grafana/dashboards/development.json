{
  "uid": "lantern-devops-development",
  "title": "Lantern · Development & Code Quality",
  "tags": [
    "Lantern",
    "DevOps"
  ],
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Lantern DevOps",
      "tags": [
        "Lantern"
      ],
      "keepTime": true,
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "squad",
        "label": "Squad",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lantern-devops-prometheus"
        },
        "definition": "label_values(lantern_service_info, squad)",
        "query": {
          "query": "label_values(lantern_service_info, squad)",
          "refId": "var-squad"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "repository",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lantern-devops-prometheus"
        },
        "definition": "label_values(lantern_service_info{squad=~\"${squad:regex}\"}, repository)",
        "query": {
          "query": "label_values(lantern_service_info{squad=~\"${squad:regex}\"}, repository)",
          "refId": "var-repository"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lantern-devops-prometheus"
        },
        "definition": "label_values(lantern_service_info{repository=~\"${repository:regex}\",squad=~\"${squad:regex}\"}, service)",
        "query": {
          "query": "label_values(lantern_service_info{repository=~\"${repository:regex}\",squad=~\"${squad:regex}\"}, service)",
          "refId": "var-service"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "combat|dungeon|frontend-game|frontend-public|leaderboard|player|rewards",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "",
      "type": "text",
      "datasource": null,
      "description": "",
      "gridPos": {
        "w": 24,
        "h": 3,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "CI covers the latest 50 workflow runs per repository, with jobs for the latest observed attempt. Rates exclude canceled, skipped and neutral runs. Sonar trends start when collection begins."
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "targets": [],
      "id": 1
    },
    {
      "title": "CI success rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "lantern-devops-prometheus"
      },
      "description": "",
      "gridPos": {
        "w": 6,
        "h": 8,
        "x": 0,
        "y": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * ((count by(service) (max_over_time(lantern_ci_completed_timestamp_seconds{service=~\"${service:regex}\",repository=~\"${repository:regex}\",squad=~\"${squad:regex}\",conclusion=~\"success\"}[$__range]) > time() - $__range_s)) or on(service) (0 * count by(service) (max_over_time(lantern_ci_completed_timestamp_seconds{service=~\"${service:regex}\",repository=~\"${repository:regex}\",squad=~\"${squad:regex}\",conclusion=~\"success|failure|timed_out|startup_failure\"}[$__range]) > time() - $__range_s))) / (count by(service) (max_over_time(lantern_ci_completed_timestamp_seconds{service=~\"${service:regex}\",repository=~\"${repository:regex}\",squad=~\"${squad:regex}\",conclusion=~\"success|failure|timed_out|startup_failure\"}[$__range]) > time() - $__range_s))",
          "legendFormat": "{{service}}",
          "format": "time_series",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lantern-devops-prometheus"
          },
          "refId": "A"
        }
      ],
      "id": 2
    },
