{
  "uid": "lantern-devops-service",
  "title": "Lantern · Service Detail",
  "tags": [
    "Lantern",
    "DevOps"
  ],
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Lantern DevOps",
      "tags": [
        "Lantern"
      ],
      "keepTime": true,
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lantern-devops-prometheus"
        },
        "definition": "label_values(lantern_service_info, service)",
        "query": {
          "query": "label_values(lantern_service_info, service)",
          "refId": "var-service"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {
          "text": "combat",
          "value": "combat"
        }
      },
      {
        "name": "loki",
        "label": "Kubernetes Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "title": "Service links",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "lantern-devops-prometheus"
      },
      "description": "",
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "github_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open repository",
                    "url": "${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sonar_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open SonarQube Cloud",
                    "url": "${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "harbor_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Harbor",
                    "url": "${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "argocd_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Argo CD",
                    "url": "${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "lantern_service_info{service=~\"${service:regex}\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lantern-devops-prometheus"
          },
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "container": true,
              "deployment": true,
              "squad": true,
              "Value": true
            },
            "indexByName": {
              "service": 0,
              "repository": 1,
              "github_url": 2,
              "sonar_url": 3,
              "harbor_url": 4,
              "argocd_url": 5
            }
          }
        }
      ],
      "id": 1
    },
    {
      "title": "Latest default-branch commit",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "lantern-devops-prometheus"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sha"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open commit",
                    "url": "https://github.com/ProjectLanternDI3P1P2/${__data.fields.repository}/commit/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "lantern_github_latest_commit_info{service=~\"${service:regex}\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lantern-devops-prometheus"
          },
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "container": true,
              "deployment": true,
              "squad": true,
              "Value": true
            },
            "indexByName": {
              "service": 0,
              "repository": 1,
              "sha": 2
            }
          }
        }
      ],
      "id": 2
    },
    {
      "title": "Last CI execution",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "lantern-devops-prometheus"
      },
      "description": "",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "options": {},
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open GitHub Actions run",
                    "url": "https://github.com/ProjectLanternDI3P1P2/${__data.fields.repository}/actions/runs/${__data.fields.run_id}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "1000 * (lantern_ci_last_run_timestamp_seconds{service=~\"${service:regex}\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lantern-devops-prometheus"
          },
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "container": true,
              "deployment": true,
              "squad": true
            },
            "indexByName": {
              "service": 0,
              "repository": 1,
              "status": 2,
              "sha": 3,
              "run_id": 4,
              "Value": 5
            }
          }
        }
      ],
      "id": 3
    },
