apiVersion: 1
datasources:
  - name: Lantern DevOps Prometheus
    uid: lantern-devops-prometheus
    orgId: 1
    type: prometheus
    access: proxy
    url: {{ lantern_kpi_prometheus_url | to_json }}
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: 30s
{% if lantern_kpi_prometheus_user %}
    basicAuth: true
    basicAuthUser: {{ lantern_kpi_prometheus_user | replace('$', '$$') | to_json }}
    secureJsonData:
      basicAuthPassword: {{ lantern_kpi_prometheus_password | replace('$', '$$') | to_json }}
{% endif %}
